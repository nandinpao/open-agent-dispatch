<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.opensocket</groupId><artifactId>control-plane-parent</artifactId><version>0.8.2-SNAPSHOT</version><relativePath>../pom.xml</relativePath></parent>
  <artifactId>resource-access-runtime-bridge</artifactId>
  <name>resource-access-runtime-bridge</name>
  <description>Controlled server-side descriptor bridge to existing Task, A2A, Issue and Agent authorities.</description>
  <dependencies>
    <dependency><groupId>com.opensocket</groupId><artifactId>resource-access-contracts</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>resource-access-core</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>security-principal-contracts</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>identity-core</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>organization-access</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>rbac</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>access-token</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>task-orchestration</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>a2a-contracts</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>issue-tracking-contracts</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>agent-control</artifactId></dependency>
    <dependency><groupId>com.opensocket</groupId><artifactId>execution-control</artifactId></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-resource-access-runtime-bridge-boundary</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                                            <exclude>org.mybatis:*</exclude>
                                            <exclude>com.opensocket:resource-access-persistence</exclude>
                                            <exclude>com.opensocket:resource-access-api</exclude>
                  </excludes>
                  <message>P4RA-A module boundary violation in resource-access-runtime-bridge.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
