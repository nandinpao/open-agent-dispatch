    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>com.opensocket.aievent.core.AiEventGatewayCoreApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>phase12-build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <releaseContract>phase12-enterprise-release-v1</releaseContract>
                                <iamAuthorityContract>human-rbac-machine-iam-v1</iamAuthorityContract>
                                <gitCommit>${opendispatch.build.gitCommit}</gitCommit>
                                <buildId>${opendispatch.build.id}</buildId>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${flyway.version}</version>
                <configuration>
                    <locations>
                        <location>filesystem:${project.basedir}/../database-platform/src/main/resources/db/migration</location>
                        <location>filesystem:${project.basedir}/../iam-persistence/src/main/resources/db/migration</location>
                    </locations>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${flyway.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
