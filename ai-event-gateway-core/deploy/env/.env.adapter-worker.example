ADAPTER_WORKER_PORT=18090
ADAPTER_WORKER_ENABLED=true
ADAPTER_WORKER_CORE_BASE_URL=http://ai-event-gateway-core:18080
ADAPTER_WORKER_ID=adapter-worker-001
ADAPTER_WORKER_TYPES=MCP
ADAPTER_WORKER_LEASE_SECONDS=120
ADAPTER_WORKER_POLL_INTERVAL_MS=2000
ADAPTER_WORKER_REQUEST_TIMEOUT=15s
ADAPTER_WORKER_TOKEN_HEADER=X-Cluster-Token
ADAPTER_WORKER_TOKEN=change-me
# Must match CORE_ADAPTER_WORKER_INTERNAL_TOKEN when CORE_INTERNAL_SECURITY_ENABLED=true.
ADAPTER_WORKER_MCP_ENDPOINT_URL=
ADAPTER_WORKER_MOCK_SUCCESS_ENABLED=false

# Runtime Configuration authority/recovery bootstrap (not business tunables).
ADAPTER_WORKER_RUNTIME_CONFIG_ENABLED=true
ADAPTER_WORKER_RUNTIME_CONFIG_FAIL_CLOSED_ON_COLD_START=true
ADAPTER_WORKER_RUNTIME_CONFIG_LKG_ENABLED=true
ADAPTER_WORKER_RUNTIME_CONFIG_LKG_DIRECTORY=./data/runtime-config/worker
ADAPTER_WORKER_RUNTIME_CONFIG_MAX_STALE_MS=300000
OPENDISPATCH_CONFIG_SNAPSHOT_HMAC_KEY=change-me-to-at-least-32-characters
