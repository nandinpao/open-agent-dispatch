<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opensocket.aievent.database.persistence.adapter.dao.AdapterExecutorAuditDao">
  <resultMap id="AuditRowMap" type="com.opensocket.aievent.database.persistence.adapter.po.AdapterExecutorAuditPo">
    <id property="auditId" column="audit_id"/><result property="actionId" column="action_id"/><result property="taskId" column="task_id"/><result property="incidentId" column="incident_id"/>
    <result property="tenantId" column="tenant_id"/><result property="correlationId" column="correlation_id"/><result property="a2aRequestId" column="a2a_request_id"/><result property="dispatchRequestId" column="dispatch_request_id"/><result property="assignmentId" column="assignment_id"/><result property="agentId" column="agent_id"/><result property="sourceSystemId" column="source_system_id"/><result property="connectionId" column="connection_id"/><result property="projectMappingId" column="project_mapping_id"/><result property="externalProjectId" column="external_project_id"/><result property="externalIssueId" column="external_issue_id"/><result property="providerStatusCode" column="provider_status_code"/><result property="providerFailureCode" column="provider_failure_code"/><result property="providerHealthImpact" column="provider_health_impact"/><result property="providerOutcomeCertainty" column="provider_outcome_certainty"/><result property="idempotencyKey" column="idempotency_key"/><result property="operationFingerprint" column="operation_fingerprint"/><result property="technicalPrincipalId" column="technical_principal_id"/><result property="credentialId" column="credential_id"/><result property="credentialVersion" column="credential_version"/>
    <result property="adapterType" column="adapter_type"/><result property="actionType" column="action_type"/><result property="executorName" column="executor_name"/>
    <result property="beforeStatus" column="before_status"/><result property="afterStatus" column="after_status"/><result property="outcome" column="outcome"/><result property="message" column="message"/>
    <result property="attemptCount" column="attempt_count"/><result property="createdAt" column="created_at"/><result property="payloadSnapshotJson" column="payload_snapshot_json"/>
  </resultMap>
  <sql id="Columns">audit_id,action_id,task_id,incident_id,tenant_id,correlation_id,a2a_request_id,dispatch_request_id,assignment_id,agent_id,source_system_id,connection_id,project_mapping_id,external_project_id,external_issue_id,provider_status_code,provider_failure_code,provider_health_impact,provider_outcome_certainty,idempotency_key,operation_fingerprint,technical_principal_id,credential_id,credential_version,adapter_type,action_type,executor_name,before_status,after_status,outcome,message,attempt_count,created_at,payload_snapshot_json</sql>
  <insert id="insertIgnore">insert into adapter_executor_audit(<include refid="Columns"/>) values(#{audit.auditId},#{audit.actionId},#{audit.taskId},#{audit.incidentId},#{audit.tenantId},#{audit.correlationId},#{audit.a2aRequestId},#{audit.dispatchRequestId},#{audit.assignmentId},#{audit.agentId},#{audit.sourceSystemId},#{audit.connectionId},#{audit.projectMappingId},#{audit.externalProjectId},#{audit.externalIssueId},#{audit.providerStatusCode},#{audit.providerFailureCode},#{audit.providerHealthImpact},#{audit.providerOutcomeCertainty},#{audit.idempotencyKey},#{audit.operationFingerprint},#{audit.technicalPrincipalId},#{audit.credentialId},#{audit.credentialVersion},#{audit.adapterType},#{audit.actionType},#{audit.executorName},#{audit.beforeStatus},#{audit.afterStatus},#{audit.outcome},#{audit.message},#{audit.attemptCount},#{audit.createdAt},coalesce(cast(#{audit.payloadSnapshotJson} as jsonb), '{}'::jsonb)) on conflict(audit_id) do nothing</insert>
  <select id="recent" resultMap="AuditRowMap">select <include refid="Columns"/> from adapter_executor_audit order by created_at desc limit #{limit}</select>
  <select id="findByActionId" resultMap="AuditRowMap">select <include refid="Columns"/> from adapter_executor_audit where action_id=#{actionId} order by created_at desc limit #{limit}</select>
</mapper>
