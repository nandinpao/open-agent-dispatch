<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opensocket.aievent.database.persistence.issueprojection.dao.IssueRelayDao">
 <resultMap id="RelayMap" type="com.opensocket.aievent.database.persistence.issueprojection.po.CrossProjectIssueRelayPo"><id property="relayId" column="relay_id"/><result property="tenantId" column="tenant_id"/><result property="a2aRequestId" column="a2a_request_id"/><result property="rootTaskId" column="root_task_id"/><result property="sourceTaskId" column="source_task_id"/><result property="targetTaskId" column="target_task_id"/><result property="sourceMappingId" column="source_mapping_id"/><result property="targetMappingId" column="target_mapping_id"/><result property="sourceSnapshotId" column="source_snapshot_id"/><result property="resultSnapshotId" column="result_snapshot_id"/><result property="sourceIssueLinkId" column="source_issue_link_id"/><result property="targetIssueLinkId" column="target_issue_link_id"/><result property="strategy" column="strategy"/><result property="relayState" column="relay_state"/><result property="nativeRelationSupported" column="native_relation_supported"/><result property="sourceBacklinkStatus" column="source_backlink_status"/><result property="targetBacklinkStatus" column="target_backlink_status"/><result property="retryCount" column="retry_count"/><result property="nextRetryAt" column="next_retry_at"/><result property="lastErrorCode" column="last_error_code"/><result property="lastErrorMessage" column="last_error_message"/><result property="idempotencyKey" column="idempotency_key"/><result property="correlationId" column="correlation_id"/><result property="version" column="version"/><result property="createdAt" column="created_at"/><result property="updatedAt" column="updated_at"/></resultMap>
 <insert id="insertRelay">insert into cross_project_issue_relays(tenant_id,relay_id,a2a_request_id,root_task_id,source_task_id,target_task_id,source_mapping_id,target_mapping_id,source_snapshot_id,result_snapshot_id,source_issue_link_id,target_issue_link_id,strategy,relay_state,native_relation_supported,source_backlink_status,target_backlink_status,retry_count,next_retry_at,last_error_code,last_error_message,idempotency_key,correlation_id,version,created_at,updated_at) values(#{value.tenantId},#{value.relayId},#{value.a2aRequestId},#{value.rootTaskId},#{value.sourceTaskId},#{value.targetTaskId},#{value.sourceMappingId},#{value.targetMappingId},#{value.sourceSnapshotId},#{value.resultSnapshotId},#{value.sourceIssueLinkId},#{value.targetIssueLinkId},#{value.strategy},#{value.relayState},#{value.nativeRelationSupported},#{value.sourceBacklinkStatus},#{value.targetBacklinkStatus},#{value.retryCount},#{value.nextRetryAt},#{value.lastErrorCode},#{value.lastErrorMessage},#{value.idempotencyKey},#{value.correlationId},#{value.version},#{value.createdAt},#{value.updatedAt})</insert>
 <update id="updateRelayState">update cross_project_issue_relays set source_snapshot_id=#{value.sourceSnapshotId},result_snapshot_id=#{value.resultSnapshotId},target_issue_link_id=#{value.targetIssueLinkId},relay_state=#{value.relayState},native_relation_supported=#{value.nativeRelationSupported},source_backlink_status=#{value.sourceBacklinkStatus},target_backlink_status=#{value.targetBacklinkStatus},retry_count=#{value.retryCount},next_retry_at=#{value.nextRetryAt},last_error_code=#{value.lastErrorCode},last_error_message=#{value.lastErrorMessage},version=#{value.version},updated_at=#{value.updatedAt} where tenant_id=#{value.tenantId} and relay_id=#{value.relayId} and version=#{value.version}-1</update>
 <select id="findRelay" resultMap="RelayMap">select * from cross_project_issue_relays where tenant_id=#{tenantId} and relay_id=#{relayId}</select>
 <select id="findRelayByIdempotencyKey" resultMap="RelayMap">select * from cross_project_issue_relays where tenant_id=#{tenantId} and idempotency_key=#{idempotencyKey}</select>
 <select id="listRelays" resultMap="RelayMap">select * from cross_project_issue_relays where tenant_id=#{tenantId}<if test="taskId != null and taskId != ''"> and (source_task_id=#{taskId} or target_task_id=#{taskId} or root_task_id=#{taskId})</if> order by created_at desc limit #{limit}</select>
 <select id="listDueRelays" resultMap="RelayMap">select * from cross_project_issue_relays where relay_state='FAILED_RETRYABLE' and next_retry_at is not null and next_retry_at&lt;=#{now} order by next_retry_at limit #{limit}</select>
 <resultMap id="RelayAttemptMap" type="com.opensocket.aievent.database.persistence.issueprojection.po.IssueRelayAttemptPo"><id property="attemptId" column="attempt_id"/><result property="tenantId" column="tenant_id"/><result property="relayId" column="relay_id"/><result property="operationCode" column="operation_code"/><result property="operationSide" column="operation_side"/><result property="providerType" column="provider_type"/><result property="projectMappingId" column="project_mapping_id"/><result property="principalId" column="principal_id"/><result property="attemptNo" column="attempt_no"/><result property="status" column="status"/><result property="providerStatus" column="provider_status"/><result property="externalIssueId" column="external_issue_id"/><result property="externalIssueUrl" column="external_issue_url"/><result property="responseSummary" column="response_summary"/><result property="errorCode" column="error_code"/><result property="retryable" column="retryable"/><result property="startedAt" column="started_at"/><result property="completedAt" column="completed_at"/><result property="correlationId" column="correlation_id"/></resultMap>
 <insert id="insertRelayAttempt">insert into issue_relay_attempts(tenant_id,attempt_id,relay_id,operation_code,operation_side,provider_type,project_mapping_id,principal_id,attempt_no,status,provider_status,external_issue_id,external_issue_url,response_summary,error_code,retryable,started_at,completed_at,correlation_id) values(#{value.tenantId},#{value.attemptId},#{value.relayId},#{value.operationCode},#{value.operationSide},#{value.providerType},#{value.projectMappingId},#{value.principalId},#{value.attemptNo},#{value.status},#{value.providerStatus},#{value.externalIssueId},#{value.externalIssueUrl},#{value.responseSummary},#{value.errorCode},#{value.retryable},#{value.startedAt},#{value.completedAt},#{value.correlationId})</insert>
 <select id="listRelayAttempts" resultMap="RelayAttemptMap">select * from issue_relay_attempts where tenant_id=#{tenantId} and relay_id=#{relayId} order by started_at limit #{limit}</select>
</mapper>
