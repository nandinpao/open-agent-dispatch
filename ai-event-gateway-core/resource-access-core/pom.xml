<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.opensocket</groupId><artifactId>control-plane-parent</artifactId><version>0.8.2-SNAPSHOT</version><relativePath>../pom.xml</relativePath></parent>
  <artifactId>resource-access-core</artifactId>
  <name>resource-access-core</name>
  <description>Framework-neutral Resource Catalog and authoritative descriptor resolution boundary.</description>
  <dependencies>
    <dependency><groupId>com.opensocket</groupId><artifactId>resource-access-contracts</artifactId></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-resource-access-core-boundary</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                                            <exclude>org.springframework:*</exclude>
                                            <exclude>org.mybatis:*</exclude>
                                            <exclude>com.opensocket:resource-access-persistence</exclude>
                                            <exclude>com.opensocket:resource-access-api</exclude>
                                            <exclude>com.opensocket:resource-access-enforcement</exclude>
                                            <exclude>com.opensocket:resource-access-runtime-bridge</exclude>
                                            <exclude>com.opensocket:task-orchestration</exclude>
                                            <exclude>com.opensocket:a2a-*</exclude>
                                            <exclude>com.opensocket:issue-*</exclude>
                                            <exclude>com.opensocket:agent-control</exclude>
                                            <exclude>com.opensocket:execution-control</exclude>
                  </excludes>
                  <message>P4RA-A module boundary violation in resource-access-core.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
