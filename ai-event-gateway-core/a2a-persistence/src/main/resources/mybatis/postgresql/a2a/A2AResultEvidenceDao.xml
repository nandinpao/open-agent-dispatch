<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opensocket.aievent.database.persistence.a2a.dao.A2AResultEvidenceDao">
 <resultMap id="Map" type="com.opensocket.aievent.database.persistence.a2a.po.A2AResultEvidencePo"><id property="evidenceId" column="evidence_id"/><result property="tenantId" column="tenant_id"/><result property="attemptId" column="attempt_id"/><result property="requestId" column="a2a_request_id"/><result property="evidenceType" column="evidence_type"/><result property="evidenceReference" column="evidence_reference"/><result property="evidenceHash" column="evidence_hash"/><result property="verificationDecision" column="verification_decision"/><result property="classification" column="classification"/><result property="resultFingerprint" column="result_fingerprint"/><result property="reasonCode" column="reason_code"/><result property="verifiedAt" column="verified_at"/></resultMap>
 <insert id="insert">insert into a2a_result_evidence(tenant_id,evidence_id,attempt_id,a2a_request_id,evidence_type,evidence_reference,evidence_hash,verification_decision,classification,result_fingerprint,reason_code,verified_at) values(#{evidence.tenantId},#{evidence.evidenceId},#{evidence.attemptId},#{evidence.requestId},#{evidence.evidenceType},#{evidence.evidenceReference},#{evidence.evidenceHash},#{evidence.verificationDecision},#{evidence.classification},#{evidence.resultFingerprint},#{evidence.reasonCode},#{evidence.verifiedAt}) on conflict(tenant_id,attempt_id,evidence_type,evidence_hash) do nothing</insert>
 <select id="findByAttempt" resultMap="Map">select * from a2a_result_evidence where tenant_id=#{tenantId} and attempt_id=#{attemptId} order by verified_at asc limit #{limit}</select>
</mapper>
