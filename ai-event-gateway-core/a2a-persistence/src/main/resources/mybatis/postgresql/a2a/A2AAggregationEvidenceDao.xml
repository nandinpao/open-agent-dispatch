<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opensocket.aievent.database.persistence.a2a.dao.A2AAggregationEvidenceDao">
 <resultMap id="Map" type="com.opensocket.aievent.database.persistence.a2a.po.A2AAggregationEvidencePo"><id property="evidenceId" column="evidence_id"/><result property="tenantId" column="tenant_id"/><result property="parentTaskId" column="parent_task_id"/><result property="resultId" column="a2a_result_id"/><result property="evidenceType" column="evidence_type"/><result property="computationHash" column="computation_hash"/><result property="aggregateStatus" column="aggregate_status"/><result property="decisionReason" column="decision_reason"/><result property="expectedVersion" column="expected_version"/><result property="resultingVersion" column="resulting_version"/><result property="attemptNo" column="attempt_no"/><result property="occurredAt" column="occurred_at"/></resultMap>
 <insert id="insert">insert into a2a_aggregation_evidence(tenant_id,evidence_id,parent_task_id,a2a_result_id,evidence_type,computation_hash,aggregate_status,decision_reason,expected_version,resulting_version,attempt_no,occurred_at) values(#{evidence.tenantId},#{evidence.evidenceId},#{evidence.parentTaskId},#{evidence.resultId},#{evidence.evidenceType},#{evidence.computationHash},#{evidence.aggregateStatus},#{evidence.decisionReason},#{evidence.expectedVersion},#{evidence.resultingVersion},#{evidence.attemptNo},#{evidence.occurredAt}) on conflict(tenant_id,parent_task_id,computation_hash,evidence_type) do nothing</insert>
 <select id="findByParentTask" resultMap="Map">select * from a2a_aggregation_evidence where tenant_id=#{tenantId} and parent_task_id=#{parentTaskId} order by occurred_at desc limit #{limit}</select>
</mapper>
