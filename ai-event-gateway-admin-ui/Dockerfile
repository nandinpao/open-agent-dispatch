# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json .npmrc ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_APP_NAME="AI Event Gateway Admin"
ARG NEXT_PUBLIC_ADMIN_BACKEND_MODE="dual"
ARG NEXT_PUBLIC_USE_MOCK="false"
ARG NEXT_PUBLIC_AUTH_ENABLED="true"
ARG NEXT_PUBLIC_CORE_API_BASE_URL="/core-api"
ARG NEXT_PUBLIC_NETTY_API_BASE_URL="/netty-api"
ARG NEXT_PUBLIC_NETTY_RUNTIME_WS_URL="/api/admin/runtime/stream"
ARG NEXT_PUBLIC_GATEWAY_API_BASE_URL="/netty-api"
ARG NEXT_PUBLIC_GATEWAY_WS_URL="/api/admin/runtime/stream"
ARG NEXT_PUBLIC_REFRESH_INTERVAL_MS="5000"
ARG NEXT_PUBLIC_REQUEST_TIMEOUT_MS="10000"
ARG NEXT_PUBLIC_API_CONTRACT_MODE="warn"
ARG NEXT_PUBLIC_WS_RECONNECT_INTERVAL_MS="3000"
ARG NEXT_PUBLIC_WS_RECONNECT_MAX_INTERVAL_MS="15000"
ARG NEXT_PUBLIC_WS_HEARTBEAT_INTERVAL_MS="30000"
ARG NEXT_PUBLIC_WS_MAX_EVENTS="200"
ARG CORE_BACKEND_ORIGIN="http://localhost:18080"
ARG NETTY_BACKEND_ORIGIN="http://localhost:18081"
ARG GATEWAY_BACKEND_ORIGIN="http://localhost:18081"

ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_ADMIN_BACKEND_MODE=$NEXT_PUBLIC_ADMIN_BACKEND_MODE
ENV NEXT_PUBLIC_USE_MOCK=$NEXT_PUBLIC_USE_MOCK
ENV NEXT_PUBLIC_AUTH_ENABLED=$NEXT_PUBLIC_AUTH_ENABLED
ENV NEXT_PUBLIC_CORE_API_BASE_URL=$NEXT_PUBLIC_CORE_API_BASE_URL
ENV NEXT_PUBLIC_NETTY_API_BASE_URL=$NEXT_PUBLIC_NETTY_API_BASE_URL
ENV NEXT_PUBLIC_NETTY_RUNTIME_WS_URL=$NEXT_PUBLIC_NETTY_RUNTIME_WS_URL
ENV NEXT_PUBLIC_GATEWAY_API_BASE_URL=$NEXT_PUBLIC_GATEWAY_API_BASE_URL
ENV NEXT_PUBLIC_GATEWAY_WS_URL=$NEXT_PUBLIC_GATEWAY_WS_URL
ENV NEXT_PUBLIC_REFRESH_INTERVAL_MS=$NEXT_PUBLIC_REFRESH_INTERVAL_MS
ENV NEXT_PUBLIC_REQUEST_TIMEOUT_MS=$NEXT_PUBLIC_REQUEST_TIMEOUT_MS
ENV NEXT_PUBLIC_API_CONTRACT_MODE=$NEXT_PUBLIC_API_CONTRACT_MODE
ENV NEXT_PUBLIC_WS_RECONNECT_INTERVAL_MS=$NEXT_PUBLIC_WS_RECONNECT_INTERVAL_MS
ENV NEXT_PUBLIC_WS_RECONNECT_MAX_INTERVAL_MS=$NEXT_PUBLIC_WS_RECONNECT_MAX_INTERVAL_MS
ENV NEXT_PUBLIC_WS_HEARTBEAT_INTERVAL_MS=$NEXT_PUBLIC_WS_HEARTBEAT_INTERVAL_MS
ENV NEXT_PUBLIC_WS_MAX_EVENTS=$NEXT_PUBLIC_WS_MAX_EVENTS
ENV CORE_BACKEND_ORIGIN=$CORE_BACKEND_ORIGIN
ENV NETTY_BACKEND_ORIGIN=$NETTY_BACKEND_ORIGIN
ENV GATEWAY_BACKEND_ORIGIN=$GATEWAY_BACKEND_ORIGIN

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY package.json package-lock.json .npmrc ./
COPY --from=deps /app/node_modules ./node_modules
RUN npm prune --omit=dev
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/next.config.runtime.mjs ./next.config.mjs
COPY --from=builder /app/scripts ./scripts

USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1

CMD ["npm", "run", "start"]
