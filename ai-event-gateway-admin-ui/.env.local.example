NEXT_PUBLIC_APP_NAME=AI Event Gateway Admin
NEXT_PUBLIC_ADMIN_BACKEND_MODE=dual
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_AUTH_ENABLED=true
ADMIN_UI_COOKIE_SECURE=false

# Core control-plane API. Core owns Agent governance, Task, Dispatch, Security Events.
NEXT_PUBLIC_CORE_API_BASE_URL=/core-api
CORE_BACKEND_ORIGIN=http://localhost:18080

# Netty runtime-plane API. Netty owns sessions, delivery runtime, callback relay runtime, realtime stream.
NEXT_PUBLIC_NETTY_API_BASE_URL=/netty-api
NETTY_BACKEND_ORIGIN=http://localhost:18081
NETTY_MACHINE_ADMIN_TOKEN=local-netty-machine-token-change-me
NEXT_PUBLIC_NETTY_RUNTIME_WS_URL=/api/admin/runtime/stream

# Backward-compatible alias for existing Netty-oriented pages.
NEXT_PUBLIC_GATEWAY_API_BASE_URL=/netty-api
GATEWAY_BACKEND_ORIGIN=http://localhost:18081
NEXT_PUBLIC_GATEWAY_WS_URL=/api/admin/runtime/stream

NEXT_PUBLIC_REFRESH_INTERVAL_MS=5000
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=10000
NEXT_PUBLIC_API_CONTRACT_MODE=warn
NEXT_PUBLIC_WS_RECONNECT_INTERVAL_MS=3000
NEXT_PUBLIC_WS_RECONNECT_MAX_INTERVAL_MS=15000
NEXT_PUBLIC_WS_HEARTBEAT_INTERVAL_MS=30000
NEXT_PUBLIC_WS_MAX_EVENTS=200

# Optional P3B-9 local smoke-test origins. These are read by scripts/e2e-smoke.mjs, not by the browser bundle.
ADMIN_UI_ORIGIN=http://localhost:3000
SMOKE_TIMEOUT_MS=5000
# Local development may opt into sample data explicitly.
NEXT_PUBLIC_ADMIN_UI_ENV=local
NEXT_PUBLIC_ALLOW_MOCK_DATA=true
NEXT_PUBLIC_ALLOW_FIXTURE_DATA=true
