# v24 Phase 1 production runtime identity. Use immutable registry digests; mutable tags are rejected by preflight.
AI_EVENT_GATEWAY_ADMIN_UI_IMAGE=<registry>/ai-event-gateway-admin-ui@sha256:<64-hex-digest>
NGINX_IMAGE=nginx@sha256:<64-hex-digest>
PUBLIC_HTTP_PORT=8080
NEXT_PUBLIC_APP_NAME=AI Event Gateway Admin
NEXT_PUBLIC_ADMIN_BACKEND_MODE=dual
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_AUTH_ENABLED=true
ADMIN_UI_COOKIE_SECURE=true

NEXT_PUBLIC_CORE_API_BASE_URL=/core-api
CORE_BACKEND_ORIGIN=http://ai-event-gateway-core:18080

NEXT_PUBLIC_NETTY_API_BASE_URL=/netty-api
NETTY_BACKEND_ORIGIN=http://ai-event-gateway-netty:18081
NETTY_MACHINE_ADMIN_TOKEN=REPLACE_WITH_SERVER_ONLY_NETTY_MACHINE_TOKEN
NEXT_PUBLIC_NETTY_RUNTIME_WS_URL=/api/admin/runtime/stream

NEXT_PUBLIC_GATEWAY_API_BASE_URL=/netty-api
GATEWAY_BACKEND_ORIGIN=http://ai-event-gateway-netty:18081
NEXT_PUBLIC_GATEWAY_WS_URL=/api/admin/runtime/stream

NEXT_PUBLIC_REFRESH_INTERVAL_MS=5000
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=10000
NEXT_PUBLIC_API_CONTRACT_MODE=warn
NEXT_PUBLIC_WS_RECONNECT_INTERVAL_MS=3000
NEXT_PUBLIC_WS_RECONNECT_MAX_INTERVAL_MS=15000
NEXT_PUBLIC_WS_HEARTBEAT_INTERVAL_MS=30000
NEXT_PUBLIC_WS_MAX_EVENTS=200

# Optional P3B-9 smoke-test origins. These are read by scripts/e2e-smoke.mjs, not by the browser bundle.
ADMIN_UI_ORIGIN=http://localhost:8080
SMOKE_TIMEOUT_MS=5000
# Production must fail closed when live APIs are unavailable.
NEXT_PUBLIC_ADMIN_UI_ENV=production
NEXT_PUBLIC_ALLOW_MOCK_DATA=false
NEXT_PUBLIC_ALLOW_FIXTURE_DATA=false


AEG_IAM_LEGACY_PASSWORD_ADAPTER_ENABLED=false
